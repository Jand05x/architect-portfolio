# FallbackResource uses mod_dir (always enabled) and requires no extra modules
# It passes all non-file/non-dir requests to index.php while preserving REQUEST_URI
<IfModule mod_dir.c>
    FallbackResource /index.php
</IfModule>

<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
</IfModule>

# If neither works, at least route 404s through Laravel
ErrorDocument 404 /index.php
