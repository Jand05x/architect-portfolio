APP_NAME=ARTOFEX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://artofexstudio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artofex_db
DB_USERNAME=artofex_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.artofexstudio.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.artofexstudio.com
MAIL_PORT=587
MAIL_USERNAME=info@artofexstudio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@artofexstudio.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SETUP_TOKEN=
# ADMIN_EMAIL=info@artofexstudio.com
# ADMIN_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
